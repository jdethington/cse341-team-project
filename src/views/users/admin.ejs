<%- include('../partials/header') %>

    <div class="content">
        <div class="page-header">
            <h1>
                <%= title %>
            </h1>
            <% if (currentUser.role==='admin' ) { %>
                <p class="page-subtitle">Managing all users in the system.</p>
                <% } else { %>
                    <p class="page-subtitle">Your account information.</p>
                    <% } %>
        </div>

        <div class="users-toolbar">
            <div class="users-toolbar-group">
                <label for="users-search">Search</label>
                <input type="search" id="users-search" name="q" placeholder="Search users...">
                <button type="button" id="users-search-btn">Search</button>
            </div>

            <div class="users-toolbar-group">
                <label for="users-role">Role</label>
                <select id="users-role" name="role">
                    <option value="">All Roles</option>
                    <option value="customer">Customer</option>
                    <option value="admin">Admin</option>
                </select>
            </div>
        </div>
        <!-- Users list - populated by client-side JavaScript -->
        <div id="users-list">
            <p>Loading users...</p>
        </div>
        <!-- Pagination controls -->
        <nav class="users-pagination" aria-label="User pages"
            style="margin-top: 1rem; display: flex; align-items: center; gap: 1rem;">
            <button type="button" class="btn" id="users-prev">Previous</button>
            <span id="users-page-info">Page 1 of 1</span>
            <button type="button" class="btn" id="users-next">Next</button>
        </nav>
        <!-- Edit modal -->
        <dialog id="edit-modal" class="auth-card">
            <h2>Edit User</h2>
            <form id="edit-form" class="auth-form">
                <input type="hidden" id="edit-id" name="id">
                <div class="form-group">
                    <label class="form-label" for="edit-name">Full Name</label>
                    <input class="form-input" type="text" id="edit-name" name="name" required>
                </div>
                <div class="form-group">
                    <label class="form-label" for="edit-username">Username</label>
                    <input class="form-input" type="text" id="edit-username" name="username" required>
                </div>
                <div class="form-group">
                    <label class="form-label" for="edit-email">Email</label>
                    <input class="form-input" type="email" id="edit-email" name="email" required>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Save Changes</button>
                    <button class="btn" type="button" id="cancel-edit">Cancel</button>
                </div>
            </form>
        </dialog>
    </div>

    <script>
        // pass server-side data to client-side JavaScript safely
        const CURRENT_USER_ID = '<%= currentUser.id %>';
        const CURRENT_USER_ROLE = '<%= currentUser.role %>';

        // pre-fill inputs from URL on page load
        const params = new URLSearchParams(window.location.search);
        document.getElementById('users-search').value = params.get('q') || '';
        document.getElementById('users-role').value = params.get('role') || '';

        // fetch users from API 
        async function fetchAndRenderUsers() {
            try {
                // read current page from URL (?page=2) or default to 1
                const params = new URLSearchParams(window.location.search);
                const page = params.get('page') || '1';
                const q = params.get('q') || '';
                const role = params.get('role') || '';

                // build the URL conditionally with only the parameters that have values
                const apiParams = new URLSearchParams();
                apiParams.set('page', page);
                apiParams.set('limit', '10');
                apiParams.set('sort', 'username');
                apiParams.set('order', 'asc');
                if (q) { apiParams.set('q', q); }
                if (role) { apiParams.set('role', role); }

                const response = await fetch(`/api/users?${apiParams.toString()}`);

                if (!response.ok) {
                    throw new Error('Failed to fetch users');
                }

                // response is now { data: [...], pagination: {...} }
                const result = await response.json();

                // render the users table
                renderUsers(result.data);

                // update the pagination controls
                updatePagination(result.pagination);

            } catch (error) {
                console.error(error);
                document.getElementById('users-list').innerHTML =
                    '<p class="alert error">Error loading users. Please try again.</p>';
            }
        }

        // render users in the DOM
        function renderUsers(users) {
            const container = document.getElementById('users-list');

            if (!users || users.length === 0) {
                container.innerHTML = '<p>No users found.</p>';
                return;
            }

            container.innerHTML = `
            <table class ="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    ${users.map(user => `
                        <tr data-id="${user._id}">
                            <td>${user.name}</td>
                            <td>${user.username}</td>
                            <td>${user.email}</td>
                            <td>${user.role?.name ?? 'unknown'}</td>
                            <td class="table-actions">
                                <button
                                    class="btn btn-small"
                                    onclick="openEditModal('${user._id}', '${user.name}', '${user.username}', '${user.email}')"
                                >
                                    Edit
                                </button>
                                <button
                                    class="btn btn-small btn-danger"
                                    onclick="handleDelete('${user._id}')"
                                >
                                    Delete
                                </button>
                            </td>
                        </tr>
                    `).join('')}
                </tbody>
            </table>
        `;
        }

        // update pagination controls in the DOM
        function updatePagination(pagination) {
            const prevBtn = document.getElementById('users-prev');
            const nextBtn = document.getElementById('users-next');
            const pageInfo = document.getElementById('users-page-info');

            if (!prevBtn || !nextBtn || !pageInfo) return;

            // update the "Page X of Y" text
            pageInfo.textContent = `Page ${pagination.page} of ${pagination.totalPages}`;

            // disable prev on first page
            prevBtn.disabled = !pagination.hasPreviousPage;

            // disable next on last page  
            nextBtn.disabled = !pagination.hasNextPage;
        }

        function goToPage(page) {
            const url = new URL(window.location.href);
            url.searchParams.set('page', String(page));
            window.location.href = url.toString();
        }

        function goToSearch(q, role) {
            const url = new URL(window.location.href);
            if (q) {
                url.searchParams.set('q', q);
            } else {
                url.searchParams.delete('q');
            }
            if (role) {
                url.searchParams.set('role', role);
            } else {
                url.searchParams.delete('role');
            }
            url.searchParams.set('page', String(1)); // reset to first page on new search
            window.location.href = url.toString();
        }

        function hookPagination() {
            const prevBtn = document.getElementById('users-prev');
            const nextBtn = document.getElementById('users-next');

            if (prevBtn) {
                prevBtn.addEventListener('click', () => {
                    const params = new URLSearchParams(window.location.search);
                    const page = Number(params.get('page') || '1') - 1;
                    if (page >= 1) goToPage(page);
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', () => {
                    const params = new URLSearchParams(window.location.search);
                    const page = Number(params.get('page') || '1') + 1;
                    goToPage(page);
                });
            }
        }

        function hookSearchAndFilter() {
            const searchInput = document.getElementById('users-search');
            const searchBtn = document.getElementById('users-search-btn');
            const roleSelect = document.getElementById('users-role');

            if (searchBtn) {
                searchBtn.addEventListener('click', () => {
                    const q = searchInput.value.trim();
                    const role = roleSelect.value;
                    goToSearch(q, role);
                });
            }

            if (roleSelect) {
                roleSelect.addEventListener('change', () => {
                    const q = searchInput.value.trim();
                    const role = roleSelect.value;
                    goToSearch(q, role);
                });
            }

            if (searchInput) {
                searchInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {                        // only search if enter is pressed, not on every keystroke
                        const q = searchInput.value.trim();
                        const role = roleSelect.value;
                        goToSearch(q, role);
                    }
                });
            }
        }

        // Open the edit modal and pre-fill the form
        function openEditModal(id, name, username, email) {
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-name').value = name;
            document.getElementById('edit-username').value = username;
            document.getElementById('edit-email').value = email;
            document.getElementById('edit-modal').showModal();
        }

        // Handle delete with confirmation
        async function handleDelete(id) {
            if (!confirm('Are you sure you want to delete this user?')) return;

            try {
                const response = await fetch(`/api/users/${id}`, {
                    method: 'DELETE',
                });

                if (!response.ok) {
                    const data = await response.json();
                    alert(data.message || 'Failed to delete user.');
                    return;
                }

                // Refresh the list without page reload
                await fetchAndRenderUsers();
            } catch (error) {
                alert('An error occurred. Please try again.');
            }
        }
        // Handle edit form submission
        document.getElementById('edit-form').addEventListener('submit', async (e) => {
            e.preventDefault();

            const id = document.getElementById('edit-id').value;
            const body = {
                name: document.getElementById('edit-name').value,
                username: document.getElementById('edit-username').value,
                email: document.getElementById('edit-email').value,
            };

            try {
                const response = await fetch(`/api/users/${id}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body),
                });

                if (!response.ok) {
                    const data = await response.json();
                    alert(data.message || 'Failed to update user.');
                    return;
                }

                // Close modal and refresh list
                document.getElementById('edit-modal').close();
                await fetchAndRenderUsers();
            } catch (error) {
                alert('An error occurred. Please try again.');
            }
        });

        // Cancel edit
        document.getElementById('cancel-edit').addEventListener('click', () => {
            document.getElementById('edit-modal').close();
        });

        // wire up pagination buttons and load users
        hookPagination();
        hookSearchAndFilter();
        fetchAndRenderUsers();
    </script>

    <%- include('../partials/footer') %>