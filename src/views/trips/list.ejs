<%- include('../partials/header') %>
<h1><%= title %></h1>

<div id="filters">
    <label for="search-input">Keyword search:</label>
    <input type="search" id="search-input" name="q" placeholder="Search trip names or descriptions...">

    <label for="region-filter">Search by Region:</label>
    <select id="region-filter">
        <option value="all">All Regions</option>
        <option value="central">Central</option>
        <option value="hokkaido">Hokkaido</option>
        <option value="kansai">Kansai</option>
        <option value="northern">Northern</option>
    </select>

    <label for="season-filter">Search by Season:</label>
    <select id="season-filter">
        <option value="all">Any Season</option>
        <option value="autumn">Autumn</option>
        <option value="spring">Spring</option>
        <option value="summer">Summer</option>
        <option value="winter">Winter</option>
    </select>
</div>

<!-- This grid starts empty and gets populated dynamically by client-side JavaScript -->
<div class="routes-grid" id="routes-grid">
    <p>Loading trips...</p>
</div>

<!-- Pagination controls stay hidden until a page of trips is rendered -->
<nav class="trips-pagination" id="trips-pagination" aria-label="Trip pages" hidden>
    <button type="button" class="trips-page-btn" id="trips-prev">Previous</button>
    <span class="trips-page-info" id="trips-page-info">Page 1 of 1</span>
    <button type="button" class="trips-page-btn" id="trips-next">Next</button>
</nav>

<script src="/js/trips-list.js"></script>

<%- include('../partials/footer') %>