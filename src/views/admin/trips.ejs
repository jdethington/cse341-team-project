<%- include('../partials/header') %>

<section class="trips-admin">
    <div class="trips-admin-heading">
        <h1>Trip Administration</h1>
        <p>Manage railway trips, reassign stations or schedules, or remove outdated entries.</p>
    </div>

        <div class="trips-admin-filters" id="trips-filters">
        <div class="filter-group">
            <label for="filter-region">Region:</label>
            <select id="filter-region">
                <option value="">All Regions</option>
                <option value="central">Central</option>
                <option value="northern">Northern</option>
                <option value="kansai">Kansai</option>
                <option value="hokkaido">Hokkaido</option>
            </select>
        </div>

        <div class="filter-group">
            <label for="filter-season">Season:</label>
            <select id="filter-season">
                <option value="">All Seasons</option>
                <option value="spring">Spring</option>
                <option value="summer">Summer</option>
                <option value="autumn">Autumn</option>
                <option value="winter">Winter</option>
            </select>
        </div>

        <div class="filter-group">
            <label for="filter-search">Search:</label>
            <input
                type="search"
                id="filter-search"
                placeholder="Search trip names or descriptions"
            >
        </div>

        <button type="button" id="filter-clear">Clear Filters</button>
    </div>

    <div id="edit-form-container" class="trips-edit-form" hidden>
        <h2>Edit Trip Details</h2>
        <form id="trip-form">
            <input type="hidden" id="trip-id">

            <div class="form-group">
                <label for="trip-name">Trip Name:</label>
                <input type="text" id="trip-name" required>
            </div>

            <div class="form-group">
                <label for="startStation">Start Station:</label>
                <select id="startStation" required>
                    <% stations.forEach(station => { %>
                        <option value="<%= station.id %>"><%= station.name %></option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group">
                <label for="endStation">End Station:</label>
                <select id="endStation" required>
                    <% stations.forEach(station => { %>
                        <option value="<%= station.id %>"><%= station.name %></option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group">
                <label for="scheduleId">Schedule:</label>
                <select id="scheduleId">
                    <option value="">No schedule change</option>
                    <% schedules.forEach(schedule => { %>
                        <option value="<%= schedule.id %>">
                            <%= schedule.departureTime %> - <%= schedule.arrivalTime %> (Trip: <%= schedule.tripId %>)
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn">Save Changes</button>
                <button type="button" id="cancel-edit" class="btn">Cancel</button>
            </div>
        </form>
    </div>

    <table class="trips-admin-table">
        <thead>
            <tr>
                <th>Trip Name</th>
                <th>Start Station</th>
                <th>End Station</th>
                <th>Schedules</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="trip-table-body"></tbody>
    </table>
    <div class="trips-admin-pagination" id="trips-pagination">
        <button type="button" id="trips-prev" disabled>Previous</button>
        <span id="trips-page-info">Page 1 of 1</span>
        <button type="button" id="trips-next" disabled>Next</button>
    </div>
</section>

<script type="application/json" id="admin-trips-data">
    <%- JSON.stringify({ stations, schedules }).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029') %>
</script>
<script src="/js/trip-admin.js"></script>

<%- include('../partials/footer') %>
