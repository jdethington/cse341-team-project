<%- include('./partials/header') %>

    <section class="bookings-hero">
        <h1>Bookings</h1>
    </section>

    <section class="bookings-catalog">
        <p id="bookings-message" class="bookings-message" hidden></p>

        <div class="bookings-state" id="bookings-loading">Loading bookings...</div>
        <div class="bookings-state bookings-error" id="bookings-error" hidden></div>
        <div class="bookings-state" id="bookings-empty" hidden>No bookings were found.</div>
        <section class="bookings-toolbar" aria-label="Booking list controls">
            <p class="bookings-page-info" id="bookings-page-info" hidden></p>
            <nav class="bookings-pagination" id="bookings-pagination" hidden>
                <button type="button" id="bookings-prev" data-action="prev-page">
                    Previous
                </button>
                <span id="bookings-page-label"></span>
                <button type="button" id="bookings-next" data-action="next-page">
                    Next
                </button>
            </nav>
        </section>
        <div class="bookings-grid" id="bookings-list"></div>

        <section class="bookings-toolbar bookings-toolbar--bottom" aria-label="Booking list pagination">
            <p class="bookings-page-info" id="bookings-page-info" hidden></p>
            <nav class="bookings-pagination" id="bookings-pagination" hidden>
                <button type="button" id="bookings-prev" data-action="prev-page">Previous</button>
                <span id="bookings-page-label"></span>
                <button type="button" id="bookings-next" data-action="next-page">Next</button>
            </nav>
        </section>

        <template id="booking-card-template">
            <article class="booking-card" data-booking-id="">
                <header class="booking-card-header">
                    <h2>
                        Booking
                        <code data-field="id"></code>
                    </h2>
                    <span class="booking-card-badge" data-field="ticket-class"></span>
                </header>

                <dl class="booking-details">
                    <div class="booking-detail">
                        <dt>Created</dt>
                        <dd data-field="created-at"></dd>
                    </div>
                    <div class="booking-detail">
                        <dt>Schedule ID</dt>
                        <dd data-field="schedule-id"></dd>
                    </div>
                    <div class="booking-detail">
                        <dt>Trip ID</dt>
                        <dd data-field="trip-id"></dd>
                    </div>
                    <div class="booking-detail">
                        <dt>Travel day</dt>
                        <dd data-field="selected-day"></dd>
                    </div>
                </dl>

                <section class="booking-passengers">
                    <h3>Passengers</h3>
                    <ul data-field="passengers"></ul>
                </section>

                <div class="booking-actions">
                    <button type="button" data-action="edit">Edit</button>
                    <button type="button" data-action="delete">Delete</button>
                </div>
            </article>
        </template>

        <template id="booking-edit-template">
            <form class="booking-card booking-edit-form" data-booking-id="">
                <header class="booking-card-header">
                    <h2>
                        Booking
                        <code data-field="id"></code>
                    </h2>
                    <span class="booking-card-badge" data-field="ticket-class-badge"></span>
                </header>

                <div class="booking-details">
                    <div class="booking-detail booking-detail--readonly">
                        <span class="booking-detail-label">Created</span>
                        <span class="booking-detail-value" data-field="created-at"></span>
                    </div>

                    <label class="booking-detail">
                        <span class="booking-detail-label">Schedule ID</span>
                        <input name="scheduleId" required autocomplete="off">
                    </label>

                    <label class="booking-detail">
                        <span class="booking-detail-label">Trip ID</span>
                        <input name="tripId" required autocomplete="off">
                    </label>

                    <label class="booking-detail">
                        <span class="booking-detail-label">Travel day</span>
                        <input name="selectedDay" required autocomplete="off">
                    </label>

                    <label class="booking-detail">
                        <span class="booking-detail-label">Ticket class</span>
                        <input name="ticketClass" required autocomplete="off">
                    </label>
                </div>

                <section class="booking-passengers">
                    <h3>Passengers</h3>
                    <ul data-field="passengers"></ul>
                </section>

                <div class="booking-actions">
                    <button type="submit">Save</button>
                    <button type="button" data-action="cancel">Cancel</button>
                </div>
            </form>
        </template>
    </section>

    <%- include('./partials/footer') %>